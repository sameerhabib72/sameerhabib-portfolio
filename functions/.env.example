# Firebase Cloud Functions Email Notification Configuration

# Recipient Email (default: sameerhabib72@gmail.com)
NOTIFICATION_RECIPIENT_EMAIL=sameerhabib72@gmail.com

# 1. SendGrid Configuration (Recommended for high-deliverability cloud functions)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=notifications@sameerhabib.dev
SENDGRID_FROM_NAME=Sameer Habib Portfolio Alerts

# 2. Nodemailer / SMTP Configuration (Alternative to SendGrid, e.g. Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sameerhabib72@gmail.com
SMTP_PASS=your_16_digit_gmail_app_password
SMTP_FROM_NAME=Sameer Habib Portfolio Alerts
SMTP_FROM_EMAIL=sameerhabib72@gmail.com
