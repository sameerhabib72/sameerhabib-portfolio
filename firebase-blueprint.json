  "firestore": {
    "/contact_messages/{msgId}": {
      "schema": "contact_messages",
      "description": "Inbound client and recruiter inquiries from the Contact Section"
    },
    "/ai_queries/{queryId}": {
      "schema": "ai_queries",
      "description": "Queries processed by the AI Assistant Center"
    },
    "/email_notifications/{logId}": {
      "schema": "email_notifications",
      "description": "Audit trail of sent email notifications"
    }
  }
