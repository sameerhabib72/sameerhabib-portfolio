        "clientName": { "type": "string" }
      }
    },
    "email_notifications": {
      "title": "Email Notification Logs",
      "description": "Logs of automated email notifications dispatched to Sameer Habib",
      "type": "object",
      "properties": {
        "recipient": { "type": "string" },
        "senderName": { "type": "string" },
        "senderEmail": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "provider": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
