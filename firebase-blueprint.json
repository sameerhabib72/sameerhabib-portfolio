      "title": "Site Settings",
      "description": "Global portfolio configuration and owner details",
      "type": "object",
      "properties": {
        "ownerName": { "type": "string" },
        "roleTitle": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "availability": { "type": "string" },
        "githubUrl": { "type": "string" },
        "linkedinUrl": { "type": "string" }
      }
    },
    "hero_data": {
